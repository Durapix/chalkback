# Copy to .env and fill in. Every value is optional for local development.
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/chalkback.db
# DATABASE_URL=postgresql+psycopg://chalkback:chalkback@localhost:5432/chalkback
PUBLIC_BASE_URL=http://localhost:8000
APP_BASE_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173"]
JWT_SECRET=

# Leave empty to run the AI pipeline in mock mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Reminders
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=
EMAIL_FROM=Chalkback <recaps@your-domain.com>
REMINDER_LEAD_HOURS=24

SEED_DEMO=true
DEMO_PASSWORD=demo-password
