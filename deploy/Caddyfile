{$SITE_ADDRESS} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# API and board images
	handle /api/* {
		reverse_proxy api:8000
	}
	handle /files/* {
		reverse_proxy api:8000
	}

	# React app (client-side routing)
	redir /app /app/
	handle_path /app/* {
		root * /srv/app
		# Fingerprinted build output never changes: cache it for a year. Everything else
		# (pages, service worker, manifest, icons) is revalidated, so deploys show up at once
		# and the service worker can update. Cloudflare follows these headers.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@fresh not path /assets/*
		header @fresh Cache-Control "no-cache"
		# Client-side routes fall back to the app; missing files stay 404 instead of being
		# answered (and cached) as HTML.
		@route not path /assets/* *.js *.css *.map *.png *.ico *.svg *.webmanifest *.json
		try_files @route {path} /index.html
		file_server
	}

	# Documentation
	redir /docs /docs/
	handle_path /docs/* {
		root * /srv/docs
		file_server
	}

	# Landing / showcase page
	handle {
		root * /srv/landing
		file_server
	}

	request_body {
		max_size 120MB
	}
}
