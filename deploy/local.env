# Run the production stack on this machine (plain HTTP, no certificates):
#   cd deploy && docker compose --env-file local.env up -d --build
# Then open http://localhost:8080. These values are for local use only.
DOMAIN=localhost
SITE_ADDRESS=:80
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
HTTPS_PORT=8443
POSTGRES_PASSWORD=local-dev-only
JWT_SECRET=local-dev-only-secret-not-for-production-use-0001
SEED_DEMO=true
ALLOW_REGISTRATION=true
